# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/object_detection_db

# --- ImageKit ---
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- YOLO-World ---
YOLO_WORLD_MODEL_PATH=yolov8s-worldv2.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45

# --- CLIP ---
CLIP_MODEL_NAME=ViT-B/32
CLIP_VERIFICATION_THRESHOLD=0.20
ENABLE_CLIP_VERIFICATION_DEFAULT=true

# --- Local scratch space for uploads before they go to ImageKit ---
TEMP_DIR=./tmp_uploads

# --- Auth (JWT) ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Video support ---
# Run YOLO-World on every Nth frame; higher = faster but choppier boxes
VIDEO_FRAME_SAMPLE_RATE=5

# --- Schema management ---
# true: auto-create tables on startup (dev convenience)
# false: use `alembic upgrade head` instead (recommended for production)
AUTO_CREATE_TABLES=true

# --- CORS ---
ALLOWED_ORIGINS=*
